# Render production example
NODE_ENV=production

# MongoDB Atlas
# Luu y: backend doc MONGODB_URI, khong phai MONGO_URI.
# Mat khau co ky tu dac biet can URL-encode (vi du @ -> %40).
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/XaloLMS?retryWrites=true&w=majority&appName=AdminMedia

# Cho phep frontend goi API. Cach nhau bang dau phay neu co nhieu domain.
# Vi du: http://localhost:3000,https://your-frontend.onrender.com
FRONTEND_ORIGINS=http://localhost:3000

# Bat buoc tren production (toi thieu 16 ky tu)
JWT_SECRET=replace-with-a-long-random-secret

# Seed tai khoan ban dau
ACA_SEED_EMAIL=aca@example.com
ACA_SEED_PASSWORD=ReplaceMe_Aca123!
ACA_SEED_NAME=Quan tri ACA

STUDENT_SEED_EMAIL=student@example.com
STUDENT_SEED_PASSWORD=ReplaceMe_Student123!
STUDENT_SEED_NAME=Hoc vien demo

# Render tu inject PORT, khong can tu dat trong dashboard.
# PORT=10000

# Cloudinary (khuyen nghi cho production neu co upload avatar)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
